{
  "name": "react-native-circle-reveal-view",
  "version": "1.0.0",
  "description": "Circular reveal transition for React Native. Reveal or hide any view with an animated expanding circle, driven by the native animation driver. Zero dependencies, TypeScript, hooks-based, works with Expo, the New Architecture and React Native 0.71+.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.tsx",
  "source": "./src/index.tsx",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "llms.txt",
    "CHANGELOG.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "clean": "rm -rf lib",
    "prepare": "bob build",
    "prepack": "npm run clean && bob build",
    "release:check": "npm run typecheck && npm run lint && npm run test && npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvlrSajjad/react-native-circle-reveal-view.git"
  },
  "keywords": [
    "react-native",
    "react-native-component",
    "circle-reveal",
    "circular-reveal",
    "reveal",
    "reveal-animation",
    "reveal-transition",
    "circle-reveal-view",
    "animated",
    "animated-view",
    "animation",
    "transition",
    "material-design",
    "expo",
    "ios",
    "android",
    "typescript"
  ],
  "author": "Sajjad Asadi <lvlr.xaus@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/lvlrSajjad/react-native-circle-reveal-view/issues"
  },
  "homepage": "https://github.com/lvlrSajjad/react-native-circle-reveal-view#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.71.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "es5",
    "printWidth": 100
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "29.7.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-builder-bob": "0.43.1",
    "test-renderer": "1.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
